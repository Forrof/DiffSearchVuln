{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diffsearchvuln.local/schemas/analysis-manifest-1.0.0.json",
  "title": "DiffSearchVuln analysis manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "run_id",
    "mode",
    "old_artifact",
    "new_artifact",
    "tools",
    "settings",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "job_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["advisory_guided", "blind_discovery"] },
    "old_artifact": { "$ref": "#/$defs/artifact" },
    "new_artifact": { "$ref": "#/$defs/artifact" },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" },
      "minItems": 1
    },
    "settings": { "type": "object" },
    "advisory": { "type": ["object", "null"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byte_size", "architecture"],
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "byte_size": { "type": "integer", "minimum": 0 },
        "architecture": { "enum": ["arm64", "arm64e"] },
        "cpu_subtype": { "type": ["string", "null"] },
        "macho_uuid": { "type": ["string", "null"] },
        "parent_sha256": {
          "type": ["string", "null"],
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "path"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    }
  }
}
