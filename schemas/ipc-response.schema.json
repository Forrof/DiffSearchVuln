{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://diffsearchvuln.local/schemas/ipc-response-1.0.0.json",
  "title": "DiffSearchVuln worker response",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "id"],
  "properties": {
    "protocol_version": { "const": "1.0.0" },
    "id": { "type": ["string", "null"] },
    "result": { "type": "object" },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "message": { "type": "string", "minLength": 1 },
        "data": { "type": "object" }
      }
    }
  },
  "oneOf": [
    { "required": ["result"], "not": { "required": ["error"] } },
    { "required": ["error"], "not": { "required": ["result"] } }
  ]
}
